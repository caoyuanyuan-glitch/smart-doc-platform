DEFAULT_MODEL_PROVIDER=qwen
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

QWEN_API_KEY=your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
AI_PROVIDER_CHAT_TIMEOUT=25

KIMI_API_KEY=your-kimi-api-key-here
MOONSHOT_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

ARKCLAW_API_KEY=your-arkclaw-api-key-here
ARKCLAW_BASE_URL=https://api.arkclaw.com/v1
ARKCLAW_MODEL=arkclaw-chat

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

KIMI_CHAT_TIMEOUT=20

REVIEW_ES_ENABLED=0
REVIEW_ES_URL=http://localhost:9200
REVIEW_ES_INDEX=review-audit-basis
REVIEW_ES_TIMEOUT=2.5
REVIEW_ES_VERIFY_CERTS=0
# 开启后 ES 作为审核依据主检索层，零命中时回退本地匹配

REVIEW_PDF_VISUAL_VERIFY=1
REVIEW_PDF_VISUAL_VERIFY_LIMIT=6
REVIEW_PDF_VISUAL_VERIFY_SCALE=1.8
